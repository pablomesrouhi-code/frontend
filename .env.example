# ─── Nabtalabo — Frontend (Next.js — EasyPanel Build / Docker) ───
# المتغيرات العامة NEXT_PUBLIC_* تُحمّل وقت `npm run build`. ضعها في Docker build args أو في EasyPanel عند بناء الصورة.

# المتجر واجهة المستخدم
NEXT_PUBLIC_SITE_URL=https://nabtalabo.store

# واجهة FastAPI (المتصفح): إذا عرّفته→يلغي كل شيء آخر حتى NEXT_PUBLIC_USE_LOCAL_API.
NEXT_PUBLIC_API_URL=https://api.nabtalabo.store

# ─── تجربة API محلي (checkout) ───
# في الإنتاج (Docker/EasyPanel) ثبّت بوضوح false وإلا بعض اللوحات يتركان المتغير فارغاً وتُحمَّل بناءً خاطئ.
NEXT_PUBLIC_USE_LOCAL_API=false
# true = المتصفّح يطلب /nabtalabo-api-proxy ثم السيرفر يوجّه لـ BACKEND_INTERNAL_URL — للتطوير فقط.
# http://localhost:8000 على الهاتف يعني «الهاتف نفسه» وليس جهاز الشغيل.

# عنوان الـ FastAPI داخل الشبكة (غير معروض للمتصفّح). عند `npm run dev` الافتراضي 127.0.0.1:8000.
# في docker-compose نمرّر http://backend:8000 وقت البناء.
# BACKEND_INTERNAL_URL=http://127.0.0.1:8000
#
# ─── لوحة الإدارة في التطوير (`/dev-admin`) ─────────────────────────────────
# عنوان يفتح من المتصفّح مباشرة للـ FastAPI (يتجاوز مشاكل بروكسي Next).
# افتراضي عند الغياب: http://127.0.0.1:8000  → لوحة الإدارة = .../api/admin
# NEXT_PUBLIC_DEV_ADMIN_ORIGIN=http://127.0.0.1:8000
# إذا Next يعمل في Docker على ويندوز/ماك والـ API خارج الحاوية:
# NEXT_PUBLIC_DEV_ADMIN_ORIGIN=http://host.docker.internal:8000
#
# لو أردت تشغيل بروكسي `/api/admin` خارج `NODE_ENV=development`:
# ADMIN_PROXY_FORCE=1

# بكسلات (اختياري) — إما NEXT_PUBLIC_* وقت البناء، أو META_PIXEL_ID كمتغير runtime على خدمة الفرونت
# عطِّل الكل فقط بـ: NEXT_PUBLIC_ENABLE_PIXELS=false
NEXT_PUBLIC_META_PIXEL_ID=
# META_PIXEL_ID=   # نفس الرقم — يكفي على EasyPanel للفرونت بدون build arg (بعد آخر نشر)
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_SNAP_PIXEL_ID=
# SNAP_PIXEL_ID=   # same ID — runtime on EasyPanel frontend (no rebuild) like META_PIXEL_ID

NEXT_PUBLIC_ENABLE_PIXELS=true
# afterInteractive = أضمن لـ Lead/Purchase على thank-you (لا تستخدمي lazyOnload في الحملات)
NEXT_PUBLIC_PIXEL_SCRIPT_STRATEGY=afterInteractive

# تحليلات الزيارات (يرسل POST إلى FastAPI /api/analytics/collect) — عطّل افتراضياً في البناء إن لم تستخدمها
NEXT_PUBLIC_ANALYTICS_ENABLED=false
# إن عرّفت ANALYTICS_INGEST_SECRET في الباكند، انسخ نفس القيمة هنا (يُرسل ترويسة X-Analytics-Secret)
NEXT_PUBLIC_ANALYTICS_SECRET=
