# ─── Nabtalabo — Frontend (Next.js — EasyPanel Build / Docker) ───
# المتغيرات العامة NEXT_PUBLIC_* تُحمّل وقت `npm run build`. ضعها في Docker build args أو في EasyPanel عند بناء الصورة.

# المتجر واجهة المستخدم
NEXT_PUBLIC_SITE_URL=https://Nabtalabo.store

# واجهة FastAPI العامة (المتصفح يتصل بها من checkout)
NEXT_PUBLIC_API_URL=https://api.nabtalabo.store

# على localhost فقط: true = استعمل http://localhost:8000 (Docker محلي). إن خليتها false أو فارغة، localhost يوجّه تلقائياً لـ api.nabtalabo.store
# NEXT_PUBLIC_USE_LOCAL_API=false

# بكسلات (اختياري)
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_SNAP_PIXEL_ID=

NEXT_PUBLIC_ENABLE_PIXELS=true
NEXT_PUBLIC_PIXEL_SCRIPT_STRATEGY=lazyOnload
